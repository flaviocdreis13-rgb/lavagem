<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ALEMANHA // Central de Lavagem</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #090a0f;
      --card-bg: #12141d;
      --card-border: #1e2230;
      --accent: #ff3b4b;
      --accent-glow: rgba(255, 59, 75, 0.25);
      --text: #ffffff;
      --text-muted: #7b829a;
      --input-bg: #0a0b12;
      --input-border: #262b3d;
      --success: #10b981;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Inter', sans-serif;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background-image: 
        radial-gradient(circle at 50% 0%, rgba(255, 59, 75, 0.08) 0%, transparent 50%),
        radial-gradient(circle at 80% 100%, rgba(255, 59, 75, 0.03) 0%, transparent 40%);
    }

    .container {
      max-width: 460px;
      width: 100%;
    }

    /* Top Navigation / Brand */
    nav {
      text-align: center;
      margin-bottom: 24px;
    }

    nav .logo-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 59, 75, 0.1);
      border: 1px solid rgba(255, 59, 75, 0.2);
      padding: 6px 14px;
      border-radius: 20px;
      margin-bottom: 12px;
    }

    nav .logo-badge span {
      width: 8px;
      height: 8px;
      background-color: var(--accent);
      border-radius: 50%;
      box-shadow: 0 0 8px var(--accent);
    }

    nav b {
      font-weight: 900;
      font-size: 1.6rem;
      letter-spacing: 3px;
      color: #fff;
    }

    nav small {
      display: block;
      color: var(--text-muted);
      font-size: 0.75rem;
      font-family: 'JetBrains Mono', monospace;
      letter-spacing: 1px;
      margin-top: 4px;
    }

    /* Header */
    header {
      text-align: center;
      margin-bottom: 24px;
    }

    header .tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.75rem;
      color: var(--accent);
      font-weight: 700;
      letter-spacing: 2px;
      margin-bottom: 6px;
    }

    header h1 {
      font-size: 1.8rem;
      font-weight: 800;
    }

    header h1 em {
      font-style: normal;
      color: var(--accent);
    }

    header p {
      color: var(--text-muted);
      font-size: 0.88rem;
      margin-top: 8px;
      line-height: 1.4;
    }

    /* Tabs */
    .tabs {
      display: flex;
      gap: 8px;
      margin-bottom: 20px;
      background: rgba(255, 255, 255, 0.02);
      padding: 4px;
      border-radius: 10px;
      border: 1px solid var(--card-border);
    }

    .tab {
      flex: 1;
      padding: 10px;
      background: transparent;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      border-radius: 8px;
      text-align: center;
      font-weight: 700;
      font-size: 0.85rem;
      letter-spacing: 1px;
      transition: all 0.2s ease;
    }

    .tab.active {
      background: var(--accent);
      color: #fff;
      box-shadow: 0 4px 12px var(--accent-glow);
    }

    /* Card Box */
    .card {
      background: var(--card-bg);
      border-radius: 16px;
      padding: 24px;
      border: 1px solid var(--card-border);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    }

    .input-group {
      margin-bottom: 16px;
    }

    .input-group label {
      display: block;
      color: var(--text-muted);
      font-size: 0.8rem;
      font-weight: 600;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .input-wrapper input {
      width: 100%;
      padding: 14px 16px;
      background: var(--input-bg);
      border: 1px solid var(--input-border);
      color: #fff;
      border-radius: 10px;
      font-size: 1.1rem;
      font-family: 'JetBrains Mono', monospace;
      outline: none;
      transition: border-color 0.2s;
    }

    .input-wrapper input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }

    /* Results Grid */
    .results {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 20px;
    }

    .result-box {
      background: rgba(10, 11, 18, 0.7);
      padding: 14px;
      border-radius: 10px;
      border: 1px solid var(--card-border);
      position: relative;
      overflow: hidden;
    }

    .result-box::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 3px;
      background: var(--accent);
    }

    .result-box span {
      display: block;
      font-size: 0.7rem;
      font-weight: 700;
      color: var(--text-muted);
      letter-spacing: 1px;
      margin-bottom: 4px;
    }

    .result-box strong {
      font-size: 1.05rem;
      color: #fff;
      font-family: 'JetBrains Mono', monospace;
    }

    /* Action Button */
    button.btn-copy {
      width: 100%;
      padding: 14px;
      margin-top: 20px;
      background: var(--accent);
      color: white;
      border: none;
      border-radius: 10px;
      font-weight: 800;
      font-size: 0.95rem;
      letter-spacing: 1px;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 4px 15px var(--accent-glow);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    button.btn-copy:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px var(--accent-glow);
    }

    button.btn-copy:active {
      transform: translateY(0);
    }

    button.btn-copy.copied {
      background: var(--success);
      box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
    }

    footer {
      text-align: center;
      margin-top: 28px;
      font-size: 0.75rem;
      color: var(--text-muted);
      font-family: 'JetBrains Mono', monospace;
      letter-spacing: 1.5px;
    }
  </style>
</head>
<body>

<div class="container">
  <nav>
    <div class="logo-badge">
      <span></span>
      <b>ALEMANHA</b>
    </div>
    <small>// CENTRAL DE LAVAGEM</small>
  </nav>

  <header>
    <div class="tag">CALCULADORA</div>
    <h1>Divisão de <em>lavagem</em></h1>
    <p>Insira o valor sujo e o sistema gera o relatório no formato ideal para o Discord.</p>
  </header>

  <div class="tabs">
    <button class="tab active" id="tabParceiro" onclick="setMode('parceiro')">PARCEIRO</button>
    <button class="tab" id="tabMembro" onclick="setMode('membro')">MEMBRO</button>
  </div>

  <div class="card">
    <div class="input-group">
      <label for="valorSujo">Dinheiro sujo (R$)</label>
      <div class="input-wrapper">
        <input type="text" id="valorSujo" placeholder="Ex: 4.000.000" oninput="handleInput(this)">
      </div>
    </div>

    <div class="input-group">
      <label for="facLavou">Fac que lavou</label>
      <div class="input-wrapper">
        <input type="text" id="facLavou" placeholder="Ex: Alemanha" oninput="calcular()">
      </div>
    </div>

    <div class="results">
      <div class="result-box">
        <span id="labelCliente">CLIENTE (75%)</span>
        <strong id="resCliente">0</strong>
      </div>
      <div class="result-box">
        <span id="labelSobra">SOBRA (20%)</span>
        <strong id="resSobra">0</strong>
      </div>
      <div class="result-box">
        <span id="labelFac">FAC (10%)</span>
        <strong id="resFac">0</strong>
      </div>
      <div class="result-box">
        <span id="labelMembro">MEMBRO (10%)</span>
        <strong id="resMembro">0</strong>
      </div>
    </div>

    <button class="btn-copy" id="btnCopy" onclick="copiarRelatorio()">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
      COPIAR RESULTADO
    </button>
  </div>

  <footer>ALEMANHA — USO INTERNO</footer>
</div>

<script>
  let modoAtual = 'parceiro';

  function formatarNumero(val) {
    if (isNaN(val) || val === null) return '0';
    return Math.floor(val).toLocaleString('pt-BR');
  }

  function setMode(mode) {
    modoAtual = mode;
    
    document.getElementById('tabParceiro').classList.toggle('active', mode === 'parceiro');
    document.getElementById('tabMembro').classList.toggle('active', mode === 'membro');

    if (mode === 'parceiro') {
      document.getElementById('labelCliente').innerText = 'CLIENTE (75%)';
      document.getElementById('labelSobra').innerText   = 'SOBRA (20%)';
      document.getElementById('labelFac').innerText     = 'FAC (10%)';
      document.getElementById('labelMembro').innerText  = 'MEMBRO (10%)';
    } else {
      document.getElementById('labelCliente').innerText = 'CLIENTE (85%)';
      document.getElementById('labelSobra').innerText   = 'SOBRA (10%)';
      document.getElementById('labelFac').innerText     = 'FAC (5%)';
      document.getElementById('labelMembro').innerText  = 'MEMBRO (5%)';
    }

    calcular();
  }

  function handleInput(input) {
    let value = input.value.replace(/\D/g, '');
    if (value) {
      input.value = parseInt(value, 10).toLocaleString('pt-BR');
    } else {
      input.value = '';
    }
    calcular();
  }

  function getRawValue() {
    const valStr = document.getElementById('valorSujo').value.replace(/\./g, '').replace(/,/g, '');
    return parseFloat(valStr) || 0;
  }

  function calcular() {
    const valor = getRawValue();

    let pCliente = modoAtual === 'parceiro' ? 0.75 : 0.85;
    let pFac     = modoAtual === 'parceiro' ? 0.10 : 0.05;
    let pMembro  = modoAtual === 'parceiro' ? 0.10 : 0.05;

    const cliente = valor * pCliente;
    const fac     = valor * pFac;
    const membro  = valor * pMembro;
    const sobra   = fac + membro;

    document.getElementById('resCliente').innerText = formatarNumero(cliente);
    document.getElementById('resSobra').innerText   = formatarNumero(sobra);
    document.getElementById('resFac').innerText     = formatarNumero(fac);
    document.getElementById('resMembro').innerText  = formatarNumero(membro);
  }

  function copiarRelatorio() {
    const rawVal = getRawValue();
    if (!rawVal) return alert("Por favor, digite o valor do dinheiro sujo!");

    let pCliente = modoAtual === 'parceiro' ? 0.75 : 0.85;
    let pFac     = modoAtual === 'parceiro' ? 0.10 : 0.05;
    let pMembro  = modoAtual === 'parceiro' ? 0.10 : 0.05;

    const clienteVal = rawVal * pCliente;
    const facVal     = rawVal * pFac;
    const membroVal  = rawVal * pMembro;
    const sobraVal   = facVal + membroVal;
    const facLavou   = document.getElementById('facLavou').value.trim();

    const texto = `Dinheiro sujo: ${formatarNumero(rawVal)}\n` +
                  `Fac que lavou: ${facLavou}\n` +
                  `Cliente: ${formatarNumero(clienteVal)}\n` +
                  `Sobra: ${formatarNumero(sobraVal)}\n` +
                  `Fac: ${formatarNumero(facVal)}\n` +
                  `Membro: ${formatarNumero(membroVal)}`;

    navigator.clipboard.writeText(texto).then(() => {
      const btn = document.getElementById('btnCopy');
      const originalText = btn.innerHTML;
      
      btn.classList.add('copied');
      btn.innerHTML = `
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
        COPIADO!
      `;

      setTimeout(() => {
        btn.classList.remove('copied');
        btn.innerHTML = originalText;
      }, 2000);
    });
  }
</script>

</body>
</html>